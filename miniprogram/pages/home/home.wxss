/* pages/home/home.wxss */

/* ============== 品牌头（大 banner 风格，参考锡山马拉松） ============== */

.brand-header {
  background: linear-gradient(135deg, #C74634 0%, #A12B1A 100%);
  color: white;
  padding: 32rpx 32rpx 56rpx;
  position: relative;
  overflow: hidden;
}

/* 装饰背景圆点 */
.brand-header::before {
  content: "";
  position: absolute;
  top: -100rpx;
  right: -100rpx;
  width: 400rpx;
  height: 400rpx;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 50%;
}
.brand-header::after {
  content: "";
  position: absolute;
  bottom: -60rpx;
  left: -60rpx;
  width: 240rpx;
  height: 240rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 50%;
}

.brand-header__top {
  position: relative;
  z-index: 2;
  display: flex;
  justify-content: space-between;  /* 🆕 两端分散：配置在左，城市在右 */
  align-items: center;
  margin-bottom: 24rpx;
}

.city-tag {
  display: inline-block;
  font-size: 22rpx;
  padding: 6rpx 20rpx;
  background: rgba(255, 255, 255, 0.18);
  border-radius: 100rpx;
  letter-spacing: 2rpx;
  backdrop-filter: blur(10rpx);
}

/* 配置按钮（齿轮） */
.config-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  background: rgba(255, 255, 255, 0.18);
  border-radius: 50%;
  backdrop-filter: blur(10rpx);
  border: 2rpx solid rgba(255, 255, 255, 0.25);
  font-size: 28rpx;
  line-height: 1;
}

.config-btn:active {
  background: rgba(255, 255, 255, 0.35);
  transform: scale(0.95);
}

.brand-header__hero {
  position: relative;
  z-index: 2;
  text-align: center;
  padding: 32rpx 0 48rpx;
}

.brand-emoji-row {
  display: flex;
  justify-content: center;
  align-items: baseline;
  gap: 8rpx;
  margin-bottom: 24rpx;
}

.brand-emoji {
  font-size: 56rpx;
  line-height: 1;
  display: inline-block;
  filter: drop-shadow(0 2rpx 6rpx rgba(0, 0, 0, 0.2));
}

/* 跑团集体感：让小人错落有致 */
.brand-emoji-row text:nth-child(1) { transform: translateY(0); }
.brand-emoji-row text:nth-child(2) { transform: translateY(-8rpx); }
.brand-emoji-row text:nth-child(3) { transform: translateY(4rpx); }
.brand-emoji-row text:nth-child(4) { transform: translateY(-6rpx); }
.brand-emoji-row text:nth-child(5) { transform: translateY(0); }

.brand-name {
  font-size: 56rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
  line-height: 1.2;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
  display: block;
  margin-bottom: 16rpx;
}

.brand-slogan {
  font-size: 28rpx;
  font-weight: 300;
  opacity: 0.92;
  letter-spacing: 2rpx;
  display: block;
}

/* 集合信息徽章（仿"鸣枪开跑"样式） */
.brand-header__meet {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin: 0 32rpx;
  padding: 16rpx 24rpx;
  background: rgba(255, 255, 255, 0.18);
  border-radius: 100rpx;
  backdrop-filter: blur(10rpx);
  border: 2rpx solid rgba(255, 255, 255, 0.25);
}

.brand-meet-icon {
  font-size: 28rpx;
}

.brand-meet-text {
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

/* 旧的 .logo / .logo-emoji 兼容（不影响其他可能用到的） */
.logo {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.logo-emoji {
  font-size: 56rpx;
}

/* 本周末天气卡片 */
.weather-card {
  background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  display: flex;
  align-items: stretch;
  position: relative;
  overflow: hidden;
}

.weather-card__col {
  flex: 1;
  text-align: center;
  padding: 8rpx 16rpx;
}

.weather-card__divider {
  width: 2rpx;
  background: rgba(0, 0, 0, 0.08);
  margin: 0 16rpx;
}

.weather-card__day {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-brand);
  margin-bottom: 4rpx;
}

.weather-card__date {
  font-size: 20rpx;
  color: var(--text-tertiary);
  margin-bottom: 12rpx;
}

.weather-card__emoji {
  font-size: 80rpx;
  line-height: 1;
  margin: 8rpx 0;
}

.weather-card__weather {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
  margin: 4rpx 0;
}

.weather-card__temp {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin: 4rpx 0;
}

.weather-card__wind {
  font-size: 20rpx;
  color: var(--text-tertiary);
  margin-top: 4rpx;
}

.weather-card__tip {
  font-size: 22rpx;
  color: var(--text-tertiary);
  text-align: center;
  margin-top: 16rpx;
}

/* 本周集合大卡 */
.up-card {
  background: var(--bg-card);
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  position: relative;
  overflow: hidden;
  border: 1rpx solid rgba(199, 70, 52, 0.08);
}

.up-card::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 8rpx;
  background: linear-gradient(90deg, var(--color-brand), var(--color-upcoming));
}

.up-card__badge {
  display: inline-block;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--color-upcoming);
  background: rgba(255, 106, 0, 0.1);
  padding: 6rpx 20rpx;
  border-radius: 100rpx;
  letter-spacing: 2rpx;
  margin-bottom: 24rpx;
}

.up-card__title {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 8rpx;
}

.up-card__when {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 24rpx;
}

.up-card__weekday {
  background: var(--color-brand);
  color: white;
  padding: 4rpx 20rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.up-card__row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin: 16rpx 0;
  font-size: 28rpx;
}

.up-card__icon {
  flex-shrink: 0;
  font-size: 36rpx;
  line-height: 1.4;
  width: 48rpx;
  text-align: center;
}

.up-card__col {
  flex: 1;
  min-width: 0;
}

.up-card__name {
  font-weight: 600;
  color: var(--text);
}

.up-card__addr {
  font-size: 24rpx;
  color: var(--text-tertiary);
  margin-top: 4rpx;
}

.up-card__note {
  margin-top: 24rpx;
  padding: 16rpx 24rpx;
  background: var(--color-brand-soft);
  border-left: 6rpx solid var(--color-brand);
  border-radius: 12rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
}

.up-card__cta {
  margin-top: 32rpx;
}

.up-card__btn {
  background: var(--color-brand);
  color: white;
  padding: 24rpx 32rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
}

/* 历史卡片（小卡） */
.history-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.history-card {
  background: var(--bg-card);
  border-radius: 24rpx;
  padding: 24rpx 32rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.04);
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.history-card:active {
  background: var(--bg-soft);
  transform: scale(0.99);
}

.history-card__date {
  flex-shrink: 0;
  width: 100rpx;
  text-align: center;
  border-right: 2rpx solid var(--divider);
  padding-right: 24rpx;
}

.history-card__month {
  font-size: 22rpx;
  color: var(--text-tertiary);
  letter-spacing: 2rpx;
}

.history-card__day {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text);
  line-height: 1.2;
  margin: 4rpx 0;
}

.history-card__weekday {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.history-card__info {
  flex: 1;
  min-width: 0;
}

.history-card__title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.history-card__meta {
  font-size: 24rpx;
  color: var(--text-secondary);
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 20rpx;
}

.history-card__arrow {
  color: var(--text-tertiary);
  font-size: 36rpx;
  flex-shrink: 0;
}

/* 空状态 */
.empty {
  padding: 48rpx 32rpx;
  text-align: center;
  color: var(--text-tertiary);
  font-size: 28rpx;
}

/* 加载 */
.loading {
  padding: 64rpx;
  text-align: center;
  color: var(--text-tertiary);
  font-size: 28rpx;
}

/* 底部 */
.footer {
  text-align: center;
  padding: 48rpx 32rpx 64rpx;
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.footer view {
  margin: 8rpx 0;
}