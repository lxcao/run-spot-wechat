.container {
  padding: 24rpx 32rpx 40rpx;
}

.loading,
.empty {
  padding: 64rpx 32rpx;
  text-align: center;
  color: var(--text-tertiary);
  font-size: 28rpx;
}

.card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid rgba(199, 70, 52, 0.08);
}

.card + .card {
  margin-top: 24rpx;
}

.name {
  font-size: 36rpx;
  font-weight: 700;
  color: #C74634;
  margin-bottom: 20rpx;
}

.block + .block {
  margin-top: 24rpx;
}

.label {
  font-size: 24rpx;
  font-weight: 600;
  color: #006241;
  letter-spacing: 2rpx;
  margin-bottom: 8rpx;
}

.line {
  font-size: 28rpx;
  color: var(--text);
  line-height: 1.6;
}
